---
import { amazonProductUrl, amazonKeywordUrl, HOME_GADGETS, STEAM_GIFT_CARDS } from '../lib/amazon';
---
<div class="ad-section">
  <div class="ad-section-inner">
    <div class="ad-block amzn-section">
      <div class="ad-block-title">
        PCゲーム環境を整える
        <span class="pr-label">PR</span>
      </div>
      <div class="ad-product-row">
        {HOME_GADGETS.slice(0, 3).map(g => (
          <a
            class="ad-product-item"
            href={amazonProductUrl(g.asin)}
            target="_blank"
            rel="nofollow noopener noreferrer"
          >
            <div class="ad-product-img">
              <img src={g.img} alt={g.name} loading="lazy" decoding="async" />
            </div>
            <div class="ad-product-info">
              <div class="ad-product-cat">{g.category}</div>
              <div class="ad-product-name">{g.name}</div>
              <div class="ad-product-price">{g.price}</div>
            </div>
          </a>
        ))}
      </div>
      <p class="amzn-note">Amazonアソシエイトとして適格販売により収入を得ています。</p>
    </div>

    <div class="ad-block amzn-section">
      <div class="ad-block-title">
        Steamギフトカード
        <span class="pr-label">PR</span>
      </div>
      <div class="gift-card-list gift-card-list-inline">
        {STEAM_GIFT_CARDS.map(c => (
          <a
            class="gift-card-btn"
            href={amazonKeywordUrl(c.keyword)}
            target="_blank"
            rel="nofollow noopener noreferrer"
          >
            <span class="gift-card-icon">{c.icon}</span>
            <span class="gift-card-label">{c.label}</span>
            <span class="gift-card-arrow">→</span>
          </a>
        ))}
      </div>
      <p class="amzn-note">Amazonアソシエイトとして適格販売により収入を得ています。</p>
    </div>
  </div>
</div>
