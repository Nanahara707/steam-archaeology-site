---
import Base from '../layouts/Base.astro';
import { getCollection } from 'astro:content';
import { getThumb } from '../lib/thumb';
import { amazonProductUrl, amazonKeywordUrl, HOME_GADGETS, STEAM_GIFT_CARDS } from '../lib/amazon';

const allArticles = await getCollection('articles');
const articles = allArticles.sort((a, b) => (b.data.score ?? 0) - (a.data.score ?? 0));

const featured = articles[0];

const totalCount = articles.length;
const anomalyCount = articles.filter(a => (a.data.anomalyFlags ?? []).length > 0).length;
const vrCount = articles.filter(a => a.data.hasVr).length;
const zombieCount = articles.filter(a => a.data.zombie).length;

const recentArticles = [...allArticles]
  .filter(a => a.data.generated)
  .sort((a, b) => (b.data.generated ?? '').localeCompare(a.data.generated ?? ''))
  .slice(0, 5);

const statusColor: Record<string, string> = {
  '稼働': 'status-active',
  '無人': 'status-empty',
  '静止': 'status-still',
  '埋没': 'status-buried',
};

function scorePips(score: number) {
  const filled = Math.round(score);
  return '█'.repeat(filled) + '░'.repeat(10 - filled);
}
---
<Base>
  <!-- ヒーローバンド -->
  <div class="hero-band" style={`--hero-img: url('${getThumb(featured.data.appid)}')`}>
    <div class="hero-band-overlay"></div>
    <div class="container">
      <div class="hero-inner">
        <div class="hero-text">
          <p class="hero-eyebrow">Steam 深層探索アーカイブ</p>
          <h1 class="hero-title">Steamの底に<br/>眠るものを、<br/>記録する。</h1>
          <div class="hero-stats">
            <div class="hero-stat-item">
              <span class="hero-stat-num">{totalCount}</span>
              <span class="hero-stat-label">観測記録</span>
            </div>
            <div class="hero-stat-item">
              <span class="hero-stat-num">{anomalyCount}</span>
              <span class="hero-stat-label">異常値</span>
            </div>
            <div class="hero-stat-item">
              <span class="hero-stat-num">{vrCount}</span>
              <span class="hero-stat-label">VR遺跡</span>
            </div>
            {zombieCount > 0 && (
              <div class="hero-stat-item">
                <span class="hero-stat-num">{zombieCount}</span>
                <span class="hero-stat-label">zombie</span>
              </div>
            )}
            <div class="hero-stat-item hero-stat-excavated" id="hero-stat-excavated" style="display:none">
              <span class="hero-stat-num hero-stat-excavated-num" id="hero-excavated-num">0</span>
              <span class="hero-stat-label">あなたの発掘</span>
            </div>
          </div>
          <div class="hero-actions">
            <a href="/random" class="btn-random">⚄ ランダム発掘</a>
            <a href="/special" class="btn-ghost-hero">特集を見る →</a>
          </div>
        </div>

        <!-- 注目記録 -->
        <a class="hero-featured" href={`/excavation/${featured.id}`}>
          <div class="hero-featured-thumb-wrap">
            <img
              class="hero-featured-thumb"
              src={getThumb(featured.data.appid)}
              alt=""
              loading="eager"
              decoding="async"
            />
          </div>
          <div class="hero-featured-body">
            <div class="hero-featured-label">注目の記録</div>
            <div class="hero-featured-eyebrow">
              {featured.data.zombie && <span class="badge badge-zombie">zombie</span>}
              {(featured.data.tags ?? []).slice(0, 2).map((tag: string) => (
                <span class="card-tag">{tag}</span>
              ))}
            </div>
            <div class="hero-featured-title">{featured.data.title}</div>
          </div>
        </a>
      </div>
    </div>
  </div>

  <div class="container">
    <div class="home-layout">

      <!-- メインカラム -->
      <div class="home-main">
        <!-- フィルター -->
        <div class="toolbar" id="filter-bar">
          <div class="toolbar-filters">
            <select id="filter-era" class="filter-select">
              <option value="">年代: すべて</option>
              <option value="2015">〜2015年</option>
              <option value="2016">2016年</option>
              <option value="2017">2017年</option>
              <option value="2018">2018年</option>
              <option value="2019">2019年</option>
              <option value="2020">2020年</option>
              <option value="2021">2021年〜</option>
            </select>
            <select id="filter-zombie" class="filter-select">
              <option value="">種別: すべて</option>
              <option value="zombie">ゾンビ開発</option>
              <option value="vr">VR遺跡</option>
            </select>
          </div>
          <div class="filter-count" id="filter-count">{totalCount}件</div>
        </div>

        <!-- カードグリッド -->
        <div class="article-grid" id="article-grid">
          {articles.map((article) => {
            const d = article.data;
            const thumb = getThumb(d.appid);
            return (
              <a
                class="card"
                href={`/excavation/${article.id}`}
                data-status={d.status ?? '埋没'}
                data-year={d.releaseYear ?? 0}
                data-vr={d.hasVr ? '1' : '0'}
                data-zombie={d.zombie ? '1' : '0'}
                style="display:none"
              >
                <div class="card-thumb-wrap">
                  <img
                    class="card-thumb"
                    src={thumb}
                    alt=""
                    loading="lazy"
                    decoding="async"
                  />
                </div>
                <div class="card-body">
                  <div class="card-eyebrow">
                    <span class="card-id">#{d.appid}</span>
                    {d.zombie && <span class="badge badge-zombie">zombie</span>}
                  </div>
                  <div class="card-title">{d.title}</div>
                  {(d.tags ?? []).length > 0 && (
                    <div class="card-tags">
                      {(d.tags ?? []).slice(0, 3).map((tag: string) => (
                        <span class="card-tag">{tag}</span>
                      ))}
                    </div>
                  )}
                  <div class="card-score-row">
                    {(d.positive ?? 0) > 0 && (
                      <span class="card-reviews">レビュー {d.positive}件</span>
                    )}
                  </div>
                  {d.lastChecked && (
                    <div class="card-checked">最終確認: {d.lastChecked}</div>
                  )}
                </div>
              </a>
            );
          })}
        </div>

        <!-- ページネーション -->
        <div class="pagination" id="pagination"></div>
      </div>

      <!-- ホームサイドバー -->
      <aside class="home-sidebar">

        <!-- 新着記録 -->
        {recentArticles.length > 0 && (
          <div class="sidebar-section">
            <div class="sidebar-section-title">新着記録</div>
            <ul class="sidebar-link-list">
              {recentArticles.map(a => (
                <li>
                  <a href={`/excavation/${a.id}`}>
                    {a.data.title}
                    <div class="sidebar-meta">
                      {a.data.generated ? a.data.generated.slice(0, 10) : ''}
                    </div>
                  </a>
                </li>
              ))}
            </ul>
            <a class="sidebar-more-link" href="/new">すべての新着を見る →</a>
          </div>
        )}

        <!-- 特集へのリンク -->
        <div class="sidebar-section">
          <div class="sidebar-section-title">特集</div>
          <div class="sidebar-feature-links">
            <a class="sidebar-feature-btn" href="/special">
              <span class="badge badge-zombie">zombie</span>
              ゾンビ開発特集
            </a>
            <a class="sidebar-feature-btn" href="/special#vr">
              <span class="badge badge-vr">VR</span>
              VR遺跡特集
            </a>
            <a class="sidebar-feature-btn" href="/era">
              <span class="sidebar-feature-icon">⌚</span>
              年代で発掘する
            </a>
          </div>
        </div>

        {/* アマゾンアフィリエイト登録後に有効化 */}

        <!-- 発掘統計 -->
        <div class="sidebar-section excavation-stats-section" id="excavation-stats" style="display:none">
          <div class="sidebar-section-title">あなたの発掘記録</div>
          <div class="excavation-stat-row">
            <span class="excavation-stat-num" id="stat-count">0</span>
            <span class="excavation-stat-label">件 / 全{totalCount}件を発掘</span>
          </div>
          <div class="excavation-stat-bar-wrap">
            <div class="excavation-stat-bar" id="stat-bar" style="width:0%"></div>
          </div>
          <a class="excavation-stat-link" href="/new">未発掘の記録を探す →</a>
        </div>

      </aside>
    </div>
  </div>
</Base>

<script>
  const PER_PAGE = 10;
  let currentPage = 1;
  let filteredCards: HTMLElement[] = [];

  const grid = document.getElementById('article-grid')!;
  const allCards = Array.from(grid.querySelectorAll<HTMLElement>('.card'));
  const countEl = document.getElementById('filter-count')!;
  const pager  = document.getElementById('pagination')!;

  // シャッフル（Fisher-Yates）
  const shuffled = [...allCards];
  for (let i = shuffled.length - 1; i > 0; i--) {
    const j = Math.floor(Math.random() * (i + 1));
    [shuffled[i], shuffled[j]] = [shuffled[j], shuffled[i]];
  }
  shuffled.forEach(c => grid.appendChild(c));

  function getFiltered(): HTMLElement[] {
    const era  = (document.getElementById('filter-era')  as HTMLSelectElement).value;
    const kind = (document.getElementById('filter-zombie') as HTMLSelectElement).value;
    return shuffled.filter(card => {
      if (era) {
        const year = parseInt(card.dataset.year ?? '0');
        if (era === '2015' && year > 2015) return false;
        if (era === '2021' && year < 2021) return false;
        if (era !== '2015' && era !== '2021' && year !== parseInt(era)) return false;
      }
      if (kind === 'zombie' && card.dataset.zombie !== '1') return false;
      if (kind === 'vr'     && card.dataset.vr     !== '1') return false;
      return true;
    });
  }

  function renderPage() {
    const start = (currentPage - 1) * PER_PAGE;
    const end   = start + PER_PAGE;
    shuffled.forEach((card, i) => {
      const idx = filteredCards.indexOf(card);
      card.style.display = (idx >= start && idx < end) ? '' : 'none';
    });
    countEl.textContent = `${filteredCards.length}件`;
    renderPager();
    window.scrollTo({ top: 0, behavior: 'smooth' });
  }

  function renderPager() {
    const total = Math.ceil(filteredCards.length / PER_PAGE);
    pager.innerHTML = '';
    if (total <= 1) return;

    // 前ページ
    if (currentPage > 1) {
      const btn = document.createElement('button');
      btn.className = 'page-btn';
      btn.textContent = '←';
      btn.addEventListener('click', () => { currentPage--; renderPage(); });
      pager.appendChild(btn);
    }

    // ページ番号（最大7つ表示）
    const range = pageRange(currentPage, total);
    range.forEach(n => {
      if (n === -1) {
        const sp = document.createElement('span');
        sp.className = 'page-ellipsis';
        sp.textContent = '…';
        pager.appendChild(sp);
        return;
      }
      const btn = document.createElement('button');
      btn.className = 'page-btn' + (n === currentPage ? ' active' : '');
      btn.textContent = String(n);
      btn.addEventListener('click', () => { currentPage = n; renderPage(); });
      pager.appendChild(btn);
    });

    // 次ページ
    if (currentPage < total) {
      const btn = document.createElement('button');
      btn.className = 'page-btn';
      btn.textContent = '→';
      btn.addEventListener('click', () => { currentPage++; renderPage(); });
      pager.appendChild(btn);
    }
  }

  function pageRange(cur: number, total: number): number[] {
    if (total <= 7) return Array.from({ length: total }, (_, i) => i + 1);
    const pages: number[] = [1];
    if (cur > 3) pages.push(-1);
    for (let i = Math.max(2, cur - 1); i <= Math.min(total - 1, cur + 1); i++) pages.push(i);
    if (cur < total - 2) pages.push(-1);
    pages.push(total);
    return pages;
  }

  function applyFilters() {
    filteredCards = getFiltered();
    currentPage = 1;
    renderPage();
  }

  document.getElementById('filter-era')?.addEventListener('change', applyFilters);
  document.getElementById('filter-zombie')?.addEventListener('change', applyFilters);

  // 初期表示
  applyFilters();

  // 発掘統計
  (function() {
    try {
      const ids: number[] = JSON.parse(localStorage.getItem('excavated_v1') ?? '[]');
      if (ids.length === 0) return;
      const total = allCards.length;
      const heroStat = document.getElementById('hero-stat-excavated')!;
      const heroNum  = document.getElementById('hero-excavated-num')!;
      heroStat.style.display = '';
      heroNum.textContent = String(ids.length);
      const section  = document.getElementById('excavation-stats')!;
      const statCount = document.getElementById('stat-count')!;
      const bar      = document.getElementById('stat-bar') as HTMLElement;
      section.style.display = '';
      statCount.textContent = String(ids.length);
      bar.style.width = `${Math.min(100, Math.round(ids.length / total * 100))}%`;
    } catch {}
  })();
</script>
