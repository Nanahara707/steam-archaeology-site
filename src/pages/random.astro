---
import Base from '../layouts/Base.astro';
import { getCollection } from 'astro:content';

const allArticles = await getCollection('articles');

const interesting = allArticles.filter(a =>
  (a.data.anomalyFlags ?? []).length > 0 ||
  a.data.zombie ||
  a.data.hasVr ||
  a.data.aiSuspect ||
  (a.data.positive ?? 0) === 0
);

const pool = interesting.length > 3 ? interesting : allArticles;
const ids = pool.map(a => a.id);
---
<Base title="ランダム発掘">
  <div class="container">
    <div class="random-page">
      <p class="hero-eyebrow" style="text-align:center; margin-bottom: 1.5rem;">ランダム発掘</p>
      <h1 class="random-title">どこへ掘るかは、<br/>運が決める。</h1>
      <p class="random-desc">
        異常値・ゾンビ・VR遺跡・レビュー0件のゲームを優先して、<br/>
        Steam深層からランダムに記録を掘り出す。
      </p>

      <button class="btn-random-large" id="random-btn">
        ⚄ 発掘する
      </button>

      <p class="random-note">
        プール {pool.length}件（異常値・ゾンビ・VR・レビュー0件を優先）
      </p>
    </div>
  </div>
</Base>

<script define:vars={{ ids }}>
  const btn = document.getElementById('random-btn');

  btn?.addEventListener('click', () => {
    if (!ids || ids.length === 0) return;
    btn.disabled = true;
    btn.textContent = '掘削中...';
    setTimeout(() => {
      const idx = Math.floor(Math.random() * ids.length);
      window.location.href = `/excavation/${ids[idx]}`;
    }, 400);
  });
</script>
