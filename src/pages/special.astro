---
import Base from '../layouts/Base.astro';
import { getCollection } from 'astro:content';
import AdSection from '../components/AdSection.astro';

const specialFeatures = (await getCollection('specials'))
  .sort((a, b) => b.data.generated.localeCompare(a.data.generated));
---
<Base title="特集">
  <div class="container">
    <div class="page-hero">
      <div class="page-hero-label">特集</div>
      <h1 class="page-hero-title">編集特集</h1>
      <p class="page-hero-desc">複数のゲームに共通するパターンをテーマで束ねた記録。</p>
    </div>

    {specialFeatures.length === 0 ? (
      <p class="empty-note">現在、特集記事はありません。順次追加予定。</p>
    ) : (
      <div class="feature-list">
        {specialFeatures.map((sf) => (
          <a class="feature-card" href={`/special/${sf.id}`}>
            <div class="feature-card-inner">
              <div class="feature-card-meta">
                <span class="badge badge-feature">特集</span>
                {sf.data.theme && <span class="feature-theme">{sf.data.theme}</span>}
              </div>
              <div class="feature-card-title">{sf.data.title}</div>
              {sf.data.featuredAppids && sf.data.featuredAppids.length > 0 && (
                <div class="feature-card-games">
                  {sf.data.featuredAppids.map((id: number) => (
                    <img
                      class="feature-game-thumb"
                      src={`https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/${id}/header.jpg`}
                      alt=""
                      loading="lazy"
                      decoding="async"
                    />
                  ))}
                </div>
              )}
            </div>
          </a>
        ))}
      </div>
    )}
    <AdSection />
  </div>
</Base>
